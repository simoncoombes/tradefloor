{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.simoncoombes/tradefloor",
  "title": "tradefloor",
  "description": "Simulated stock markets that react to your orders: run, fork and score trading agents.",
  "repository": {
    "url": "https://github.com/simoncoombes/tradefloor",
    "source": "github"
  },
  "websiteUrl": "https://docs.tradefloor.dev/mcp-local.html",
  "version": "0.8.7",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "tradefloor",
      "version": "0.8.7",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "tradefloor[mcp]==0.8.7",
          "description": "Install the MCP extra at the same version."
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
