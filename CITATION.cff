    given-names: Simon
    email: simon@coombes.io
version: 0.6.2
date-released: "2026-09-01"
license:
  - MIT
  - Apache-2.0
repository-code: "https://github.com/simoncoombes/tradefloor"
url: "https://tradefloor.dev/"
keywords:
  - market simulation
  - limit order book
  - deterministic simulation
  - agent-based finance
  - reproducible research
  - transaction cost analysis
